{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TitaouPosCRM",
  "version": "0.6.4",
  "identifier": "com.titaou.poscrm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TitaouPosCRM — Point of Sale + TitaouCRM Admin Station",
        "width": 1366,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/titaou-bedreddine/TitaouPosCRM/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2NDlDOUIxOEJERTYzQzMKUldURFk5NkxzY2xKTmpHUktzZVhuVlcwTzdqbE5ua0l1czhvUlRKd0JUTWl3RENMY0xRbTh5ZloK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "AclasSDK.dll",
      "AclasSDK.ini"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  }
}
